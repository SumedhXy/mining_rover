# Mining Rover Software — .gitignore
# Production & Open-Source Cleanliness Standard

# ── Python Runtime & Compilation Artifacts ───────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyc
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.spec

# ── Virtual Environments ───────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env.venv/
env.bak/
venv.bak/

# ── Secrets & Environment Variables — NEVER COMMIT ─────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# ── Database & Storage Files ───────────────────────────────────────────────
database/mining_rover.db
database/mining_rover.db-wal
database/mining_rover.db-shm
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── Logs & Runtime Dumps ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Dashboard & Node.js Artifacts ──────────────────────────────────────────
node_modules/
dashboard/node_modules/
.next/
dashboard/.next/
out/
dashboard/out/
dashboard/dist/
.npm/
.yarn/
*.tsbuildinfo

# ── Model Weights (Large Binary Files) ──────────────────────────────────────
# Note: Lightweight reference weights can be kept or downloaded on deployment
vision/weights/*.pt
vision/weights/*.onnx
vision/weights/*.tflite
vision/weights/*.engine
vision/weights/best_ncnn_model/

# ── Testing & Code Coverage ────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.coveragerc

# ── IDE & Editor Artifacts ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ── OS Artifacts ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Temporary & Scratch Files ──────────────────────────────────────────────
tmp/
temp/
scratch/
.tempmediaStorage/
acceptance_test_report.json

# ── Deployment Local Overrides ─────────────────────────────────────────────
deployment/*.local.sh
deployment/*.local.service
