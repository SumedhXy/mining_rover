# =============================================================================
# Mining Rover Software — Environment Configuration Template (Phase 6)
# =============================================================================
# Copy this file to .env and set appropriate values for your deployment.
# Never commit .env (with real values) to version control.
#
# Environment variables take precedence over config/config.yaml.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# Path to the local SQLite database file.
# Raspberry Pi example: /home/rover/data/mining_rover.db
ROVER_DB_PATH=./database/mining_rover.db

# ── Backend API ───────────────────────────────────────────────────────────────
# Host and port for the FastAPI server.
# Use 0.0.0.0 for LAN access from the dashboard browser.
ROVER_BACKEND_HOST=0.0.0.0
ROVER_BACKEND_PORT=8000

# Comma-separated list of allowed CORS origins.
# Use * to allow all origins (development / local dashboard).
ROVER_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Sync ──────────────────────────────────────────────────────────────────────
# Enable or disable the background sync worker.
# Set to false for fully air-gapped (no remote upload) operation.
ROVER_SYNC_ENABLED=true

# Remote server URL that receives sync batches from this rover.
# Default: localhost (self-sync / simulation mode).
# Production: http://<base-station-ip>:8000/api/sync/receive
ROVER_SYNC_SERVER_URL=http://127.0.0.1:8000/api/sync/receive

# URL polled by NetworkMonitor to confirm remote reachability.
ROVER_SYNC_HEALTH_URL=http://127.0.0.1:8000/api/health

# Sync worker poll interval (seconds).
ROVER_SYNC_INTERVAL=5.0

# ── Vision ────────────────────────────────────────────────────────────────────
# Path to YOLO .pt weights file.
# If missing, the rover runs in simulated perception mode.
ROVER_VISION_MODEL=./vision/weights/best.pt

# ── Logging ───────────────────────────────────────────────────────────────────
# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
